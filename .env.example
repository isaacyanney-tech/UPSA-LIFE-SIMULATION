# Local PostgreSQL URL from docker-compose.yml.
DATABASE_URL=postgres://upsa_life:local_upsa_life_password@localhost:5432/upsa_life
# Set DATABASE_SSL=true when your managed PostgreSQL provider requires TLS.
DATABASE_SSL=false
NODE_ENV=development
PORT=3000
# Number of trusted reverse-proxy hops (usually 1 for a single app host proxy).
TRUST_PROXY_HOPS=0
